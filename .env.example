# ── 회사 위치 (필수) ──────────────────────────────────────────
# 아래 기본값은 공덕역 좌표입니다. 건물 정문 기준으로 맞추려면
#   python3 scripts/find_coords.py "공덕역 신원빌딩"
# 또는 네이버 지도에서 건물을 찍고 주소창의 c=경도,위도,... 값을 읽어 넣으세요.
OFFICE_NAME=신원빌딩 (공덕역 4번출구)
OFFICE_LAT=37.54306
OFFICE_LNG=126.95111

# 추천 반경(미터). 도보 기준 500m ≈ 7분, 800m ≈ 11분
SEARCH_RADIUS_M=500

# 한 번에 추천할 식당 수
RECOMMEND_COUNT=3

# ── 네이버 검색 API (식당 목록 수집용) ────────────────────────
# https://developers.naver.com/apps 에서 "검색" API 신청 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 구글 Places API - 영업시간 전용 (선택, 권장) ──────────────
# 네이버 지역검색 API 는 영업시간을 주지 않습니다. 구글은 공식 API 로 줍니다.
# 이 키를 넣으면 '점심에 문 여는 곳인지' 판정을 공식 경로로 합니다.
# https://console.cloud.google.com 에서 Places API (New) 를 켜고 발급하세요.
# 식당 한 곳당 한 번만 호출하고 결과를 DB 에 저장하므로 호출량은 적습니다.
#
# 주의: 구글은 무료 한도 안에서 쓰더라도 결제 계정(카드) 등록을 요구합니다.
# 영업시간 필드는 Enterprise SKU 라 무료 한도가 월 1,000건입니다.
# 반경 안 식당이 100곳이면 월 1회 갱신에 100건이라 한도의 10% 수준이지만,
# 사고를 막으려고 앱 자체에 월 상한을 둡니다. 넘으면 구글 호출을 멈추고
# 네이버 쪽으로 넘어갑니다. 구글 클라우드 콘솔에서 할당량 상한도 함께 거세요.
GOOGLE_MAPS_API_KEY=
GOOGLE_MONTHLY_CALL_LIMIT=900

# ── 네이버 플레이스 리뷰 지표 (선택) ──────────────────────────
# '음식이 맛있어요' 비율 수집. 공식 API가 아니라 비공식 엔드포인트라
# 언제든 막힐 수 있습니다. 끄면 앱은 그대로 동작하고 해당 지표만 빕니다.
ENABLE_PLACE_REVIEW_SCRAPE=0

# 서버
HOST=0.0.0.0
PORT=8000
DB_PATH=data/lunch.db
