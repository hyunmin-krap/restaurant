# ── 회사 위치 (필수) ──────────────────────────────────────────
# scripts/find_coords.py 로 주소를 넣으면 좌표를 찾아줍니다.
OFFICE_NAME=우리 회사
OFFICE_LAT=37.4979
OFFICE_LNG=127.0276

# 추천 반경(미터). 도보 기준 500m ≈ 7분, 800m ≈ 11분
SEARCH_RADIUS_M=500

# 한 번에 추천할 식당 수
RECOMMEND_COUNT=3

# ── 네이버 검색 API (식당 목록 수집용) ────────────────────────
# https://developers.naver.com/apps 에서 "검색" API 신청 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 네이버 플레이스 리뷰 지표 (선택) ──────────────────────────
# '음식이 맛있어요' 비율 수집. 공식 API가 아니라 비공식 엔드포인트라
# 언제든 막힐 수 있습니다. 끄면 앱은 그대로 동작하고 해당 지표만 빕니다.
ENABLE_PLACE_REVIEW_SCRAPE=0

# 서버
HOST=0.0.0.0
PORT=8000
DB_PATH=data/lunch.db
